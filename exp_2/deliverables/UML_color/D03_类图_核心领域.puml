skinparam ClassHeaderBackgroundColor #D8E7DE
skinparam ClassBorderColor #476858
skinparam DatabaseBackgroundColor #EAF2ED
skinparam DatabaseBorderColor #476858
skinparam ActivityBackgroundColor #EAF2ED
skinparam ActivityBorderColor #476858
skinparam ActivityDiamondBackgroundColor #F4EDD9
skinparam ActivityDiamondBorderColor #8A7954
skinparam ActivityStartColor #476858
skinparam ActivityEndColor #476858
skinparam StateBackgroundColor #EAF2ED
